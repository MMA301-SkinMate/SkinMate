
{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": "skinmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qangz.frontend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần truy cập camera để quét bảng thành phần mỹ phẩm."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c98ef711-7a3a-415c-8824-bfaa2ae33eae"
      }
    }
  }
}
