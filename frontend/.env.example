# Public frontend configuration only. Never add API keys or other secrets here.
# Android emulator -> http://10.0.2.2:5000/api
# Physical iPhone/Android -> http://<computer-LAN-IP>:5000/api (same Wi-Fi).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Reserved flag for a later step. Mock API support is not implemented yet.
EXPO_PUBLIC_USE_MOCK_API=true

# Development only. The production app never shows the component catalog.
EXPO_PUBLIC_SHOW_COMPONENT_PREVIEW=false

