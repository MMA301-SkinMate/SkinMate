# Copy this file to backend/.env and fill in your development configuration.
NODE_ENV=development
PORT=5000

# Required: use your MongoDB Atlas connection string and database name.
# Example: mongodb+srv://<username>:<password>@<cluster>/skinmate_dev?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/skinmate

# HTTP logging level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Comma-separated HTTP(S) origins, e.g. http://localhost:8081,https://app.example.com
# Empty: allow browser origins in development/test; production allows no browser origins.
# Requests without an Origin header (native mobile clients) are always allowed.
CORS_ORIGINS= http://localhost:8081

# Maximum requests per IP to /api during a 15-minute window (single-process memory store).
RATE_LIMIT_MAX=100

# Generate each JWT secret independently (run twice):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters; the two secrets must differ. Never commit real secrets.
JWT_ACCESS_SECRET= 
JWT_REFRESH_SECRET=

# Development metadata only. Set approved document versions before production.
# The frontend must show the matching documents before asking for consent.
TERMS_VERSION=development-only
PRIVACY_VERSION=development-only

# Password recovery via authenticated SMTP. Leave host/user/pass empty to disable.
# Port 465: SMTP_SECURE=true (TLS). Port 587: false (STARTTLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use a sender address allowed by your SMTP provider.
RESET_EMAIL_FROM=
# Browser landing page served by this backend. Required for password recovery emails.
# Android Studio Emulator reaches your PC via 10.0.2.2; match PORT above.
# Use a reachable HTTPS backend/tunnel URL in production or on other devices.
PASSWORD_RESET_PAGE_URL=http://10.0.2.2:5000/reset-password
# Expo Go destination: copy the reachable Metro address and append /--/reset-password.
# Example only; replace the host with your actual Metro host.
PASSWORD_RESET_URL=exp://192.168.1.100:8081/--/reset-password
# Restart the backend and request a NEW email after changing these URLs.
# Email -> browser page -> tap Open in Expo Go -> reset-password screen.
# Opening the page does not consume the token. Browser app-opening prompts vary by device.
