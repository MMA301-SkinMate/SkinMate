PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skinmate
NODE_ENV=development

# Generate different long random values for each secret. Never commit backend/.env.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password reset
PASSWORD_RESET_EXPIRES_IN=15m
PASSWORD_RESET_DEEP_LINK_BASE=skinmate://reset-password

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=SkinMate <no-reply@example.com>

# Google OAuth. Register GOOGLE_REDIRECT_URI exactly in Google Cloud Console.
PUBLIC_BACKEND_URL=https://your-public-backend.example.com
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-public-backend.example.com/api/auth/google/callback
GOOGLE_STATE_EXPIRES_IN=10m
GOOGLE_EXCHANGE_EXPIRES_IN=5m
MOBILE_AUTH_DEEP_LINK_BASE=skinmate://auth
